# Stripe TEST mode secret key (never commit the real .env)
STRIPE_SECRET_KEY=sk_test_...

# Supplier Connect accounts (test mode). Purchases are routed to these as
# destination charges when the account can accept transfers; otherwise the
# charge stays on the platform and the account id is recorded in metadata.
STRIPE_SUPPLIER_BOOKER=acct_...
STRIPE_SUPPLIER_BIDFOOD=acct_...
STRIPE_SUPPLIER_BEANBROS=acct_...

# LLM API key (Anthropic)
LLM_API_KEY=sk-ant-...

# Cognee uses the same LLM key; set these so it doesn't ask for OPENAI_API_KEY
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5

# Cognee Cloud (memory.py). Run `python memory.py --seed` once to load policy + history.
COGNEE_SERVICE_URL=https://tenant-....aws.cognee.ai
COGNEE_API_KEY=...
